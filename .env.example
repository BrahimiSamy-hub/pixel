# Database. Local SQLite file by default; for production use Turso:
#   DATABASE_URL=libsql://<db>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/pixel.db
DATABASE_AUTH_TOKEN=

# Base URL encoded in every client QR code (no trailing slash).
# Set it to the final domain BEFORE printing business cards: changing it changes every QR.
CARD_BASE_URL=https://pixelcreativeagency.net
